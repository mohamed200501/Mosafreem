# ==============================================================================
# Masaferin Platform - Environment Variables Template
# Copy this file to .env.local and configure your credentials.
# Leave provider keys blank to run in full high-fidelity Interactive Demo Mode.
# ==============================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase / PostgreSQL Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Amadeus Flight GDS Credentials (Optional - Phase 2)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Payment Gateway (Paymob / Tap / Stripe)
PAYMENT_GATEWAY_PROVIDER=demo
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# Notification Delivery (Resend / SendGrid)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=support@masaferin.com
